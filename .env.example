# Configuração do Nexus (o install.sh preenche sozinho)
NEXUS_PORT=3000
NEXUS_HOST=127.0.0.1
NEXUS_DATA=dados
NEXUS_PROJECTS=
NEXUS_SECRET=
NEXUS_PUBLIC_URL=
# IA local (llama-server)
LLM_URL=http://127.0.0.1:8080/v1
LLM_MODEL=qwen3-4b
EMBED_URL=http://127.0.0.1:8081/v1
# Build Android no servidor
ANDROID_HOME=
AAPT2_ARM64=
JAVA17_HOME=/usr/lib/jvm/java-17-openjdk-arm64
JAVA21_HOME=/usr/lib/jvm/java-21-openjdk-arm64
NEXUS_KEYSTORE=
NEXUS_KEYSTORE_PASS=
# Opcional: NDK ARM64 (só se quiser compilar apps Expo no próprio servidor)
ANDROID_NDK_HOME=
